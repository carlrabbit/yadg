<Project>
  <!-- The .NET tool-pack target rejects a Windows TFM even though this product's
       implementation must remain Windows-targeted for the Word COM renderer.
       Keep the real TFM and clear only the SDK validation discriminator while
       PackAsTool is evaluated; COMReference generation remains unchanged. -->
  <Target Name="YadgPackToolWindowsTfmCompatibility" BeforeTargets="_PackToolValidation" Condition="'$(PackAsTool)' == 'true'">
    <PropertyGroup>
      <TargetPlatformIdentifier></TargetPlatformIdentifier>
      <_ToolPackShortTargetFrameworkName>net10.0</_ToolPackShortTargetFrameworkName>
    </PropertyGroup>
  </Target>
</Project>
