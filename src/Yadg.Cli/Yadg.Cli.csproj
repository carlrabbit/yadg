<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>yadg</AssemblyName>
    <RootNamespace>Yadg.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Yadg</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>yadg</ToolCommandName>
    <Authors>carlrabbit</Authors>
    <Description>Template-first document authoring from Markdown and prepared DOCX templates.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/carlrabbit/yadg</RepositoryUrl>
    <PackageProjectUrl>https://github.com/carlrabbit/yadg</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>documents;docx;markdown;templates;word</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yadg.Core\Yadg.Core.csproj" />
    <ProjectReference Include="..\Yadg.Word\Yadg.Word.csproj" />
    <ProjectReference Include="..\Yadg.Renderer\Yadg.Renderer.csproj" />
    <ProjectReference Include="..\Yadg.WordRenderer\Yadg.WordRenderer.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildProjectDirectory)\..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
